# Public URL used by the Studio OAuth callback. No trailing slash.
CMS_SITE_URL=https://cmosqueda.vercel.app

# Create a GitHub OAuth App with callback URL:
# https://cmosqueda.vercel.app/api/studio/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional: live Vercel state inside the Studio deploy checker.
# Without these, the checker still compares repo HEAD against the deployed
# build via content-manifest.json; with them it also shows BUILDING/READY.
# VERCEL_TOKEN= (personal token with read access to the project)
# VERCEL_PROJECT_ID= (Project Settings > General > Project ID)
# VERCEL_TEAM_ID= (only if the project lives under a team)
